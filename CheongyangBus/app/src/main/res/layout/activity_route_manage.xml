<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="노선 관리"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="출발 터미널 → 도착 터미널 노선을 추가하거나 삭제합니다. 시간표는 노선을 고른 뒤 추가합니다."
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/addRouteButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="+ 노선 추가"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/emptyRouteText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="등록된 노선이 없습니다."
        android:textColor="@color/muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/routeRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="관리자 화면으로 돌아가기" />

</LinearLayout>
