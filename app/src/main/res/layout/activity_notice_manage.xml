<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="공지사항 관리"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="공지사항을 추가·수정·삭제합니다."
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/addNoticeButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="+ 공지사항 추가"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/emptyNoticeText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="등록된 공지사항이 없습니다."
        android:textColor="@color/muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/noticeRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="관리자 화면으로 돌아가기" />

</LinearLayout>
